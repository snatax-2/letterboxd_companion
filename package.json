{
  "name": "ludex-rating-companion",
  "version": "1.1.0",
  "description": "Ludex Rating Companion — app de notation de films avec recherche TMDb, watchlist et providers de streaming (BE).",
  "private": true,
  "scripts": {
    "build": "node scripts/build-app-js.js && npm run lint && node scripts/minify.js && node scripts/generate-sw-cache.js",
    "build:js": "node scripts/build-app-js.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "pretest:e2e": "node scripts/build-app-js.js && node scripts/minify.js --css-only",
    "test:e2e": "playwright test",
    "precheck:load": "node scripts/build-app-js.js",
    "check:load": "node scripts/check-load.js",
    "prelint": "node scripts/build-app-js.js",
    "lint": "eslint src api scripts app.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.0",
    "clean-css": "^5.3.3",
    "eslint": "^10.7.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "terser": "^5.50.0"
  },
  "dependencies": {
    "@upstash/redis": "1.38.3"
  }
}
