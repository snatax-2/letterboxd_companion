TMDB_KEY=your_tmdb_api_key_here

# Optionnel : notes externes IMDb / Rotten Tomatoes / Metacritic sur les fiches films
OMDB_KEY=your_omdb_api_key_here

# Optionnel : mentor d'analyse filmique. Sans cette clé, le reste de l'app fonctionne.
GEMINI_API_KEY=your_gemini_api_key_here

# Synchronisation cloud (Supabase) — voir README.md, section "Synchronisation cloud"
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Limitation de débit partagée (Upstash Redis via Vercel Marketplace) —
# optionnel mais RECOMMANDÉ en production.
# Sans ces variables, le compteur retombe sur la mémoire de l'instance : en
# serverless, chaque démarrage à froid le remet à zéro, donc la protection
# contre l'énumération de codes de synchronisation devient quasi nulle.
# Provisionner : Vercel Marketplace > Upstash > Redis, puis connecter la
# ressource au projet. Les anciens stores Vercel KV migrés restent compatibles
# grâce aux alias KV_REST_API_URL / KV_REST_API_TOKEN acceptés par le code.
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
